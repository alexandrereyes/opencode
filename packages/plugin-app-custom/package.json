{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-app-custom",
  "version": "2.0.0",
  "description": "Custom OpenCode app integrations",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-app-custom"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./snippets/rpc": "./src/snippets/rpc.ts",
    "./native-apps/rpc": "./src/native-apps/rpc.ts",
    "./directories/rpc": "./src/directories/rpc.ts",
    "./subscriptions/rpc": "./src/subscriptions/rpc.ts",
    "./worktrees/rpc": "./src/worktrees/rpc.ts",
    "./navigation/rpc": "./src/navigation/rpc.ts",
    "./archive/rpc": "./src/archive/rpc.ts",
    "./preferences/rpc": "./src/preferences/rpc.ts",
    "./master/rpc": "./src/master/rpc.ts",
    "./voice/rpc": "./src/voice/rpc.ts",
    "./speech/rpc": "./src/speech/rpc.ts",
    "./device/rpc": "./src/device/rpc.ts",
    "./resources/rpc": "./src/resources/rpc.ts",
    "./resources/protocol": "./src/resources/protocol.ts",
    "./chats/rpc": "./src/chats/rpc.ts",
    "./session-family/rpc": "./src/session-family/rpc.ts",
    "./transcript/rpc": "./src/transcript/rpc.ts",
    "./quotes/rpc": "./src/quotes/rpc.ts",
    "./live-activity/rpc": "./src/live-activity/rpc.ts",
    "./watch/rpc": "./src/watch/rpc.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@expo/serve-sim": "0.10.3",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
