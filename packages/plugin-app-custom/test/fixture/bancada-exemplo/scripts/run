#!/usr/bin/env bash
# `run` do projeto de exemplo: o comportamento vem dos argumentos, para os testes da Bancada injetarem cada caso.
# --cenarios N; --falha <id> (falha com mensagem e evidência); --perde <id> (não grava o resultado); --dorme <s>;
# --sai <código>; --sem-summary; --sem-planned; --marca <arquivo> (copia um arquivo do checkout para a saída: prova de
# que rodou naquele commit); --ambiente (grava em ambiente.txt os nomes das variáveis que recebeu); --conteiner (deixa
# rodando um contêiner com o rótulo BANCADA_DOCKER_LABEL, que a Bancada apaga no fim). Com BANCADA_APENAS,
# roda só aqueles cenários. Com aparelhos no BANCADA_DEVICES, prova que cada um chegou pronto, um cenário por item
# (Android: ligado, limpo, Wi-Fi desligado, alcança a porta concedida na máquina; iOS: ligado, limpo, captura de tela,
# porta livre; e faixas de porta que não se repetem), com captura de tela do aparelho como evidência do que falha.
# Bash 3.2 (o do macOS).
set -eu
cenarios=2
falhas=" "
perdas=" "
dorme=0
sai=""
sem_summary=""
sem_planned=""
marca=""
ambiente=""
conteiner=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cenarios) cenarios=$2; shift 2 ;;
    --falha) falhas="$falhas$2 "; shift 2 ;;
    --perde) perdas="$perdas$2 "; shift 2 ;;
    --dorme) dorme=$2; shift 2 ;;
    --sai) sai=$2; shift 2 ;;
    --sem-summary) sem_summary=1; shift ;;
    --sem-planned) sem_planned=1; shift ;;
    --marca) marca=$2; shift 2 ;;
    --ambiente) ambiente=1; shift ;;
    --conteiner) conteiner=1; shift ;;
    *) shift ;;
  esac
done
out=${BANCADA_OUT:?BANCADA_OUT não definido}
mkdir -p "$out"
# Os aparelhos do devices.json, um por linha (o formato que a Bancada grava).
aparelhos=""
if [ -n "${BANCADA_DEVICES:-}" ] && [ -f "$BANCADA_DEVICES" ]; then
  aparelhos=$(grep '"plataforma"' "$BANCADA_DEVICES" || true)
fi
campo() { printf '%s' "$1" | sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p"; }
numero() { printf '%s' "$1" | sed -n "s/.*\"$2\":\([0-9][0-9]*\).*/\1/p"; }
adb=adb
for candidato in "${ANDROID_HOME:-}/platform-tools/adb" "${HOME:-}/Library/Android/sdk/platform-tools/adb" /opt/android-sdk/platform-tools/adb; do
  if [ -x "$candidato" ]; then adb=$candidato; break; fi
done
ids_aparelhos=""
if [ -n "$aparelhos" ]; then
  i=0
  while IFS= read -r linha; do
    i=$((i + 1))
    case "$(campo "$linha" plataforma)" in
      # Wi-Fi desligado só no emulador da própria máquina (adb local): no contêiner do host-6 é a única rede.
      android)
        case "$linha" in
          *'"adb":{"host":"127.0.0.1"'*) ids_aparelhos="$ids_aparelhos ligado-$i limpo-$i wifi-$i rede-$i" ;;
          *) ids_aparelhos="$ids_aparelhos ligado-$i limpo-$i rede-$i" ;;
        esac ;;
      ios) ids_aparelhos="$ids_aparelhos ligado-$i limpo-$i captura-$i porta-$i" ;;
    esac
  done <<FIM
$aparelhos
FIM
  ids_aparelhos="$ids_aparelhos portas-distintas"
fi

ids=""
if [ -n "${BANCADA_APENAS:-}" ]; then
  ids=$(tr '\n' ' ' < "$BANCADA_APENAS")
else
  i=1
  while [ "$i" -le "$cenarios" ]; do
    ids="$ids c$i"
    i=$((i + 1))
  done
  ids="$ids$ids_aparelhos"
fi
# O planned.json vem antes de tocar em qualquer aparelho (a menos que o `plan` já o tenha gravado).
if [ -z "$sem_planned" ] && [ ! -f "$out/planned.json" ]; then
  {
    printf '{ "versao": 1, "cenarios": ['
    sep=""
    for id in $ids; do
      printf '%s{ "id": "%s", "nome": "Exemplo › cenário %s" }' "$sep" "$id" "$id"
      sep=", "
    done
    printf '] }\n'
  } > "$out/planned.json"
fi
if [ -n "$marca" ]; then cp "$marca" "$out/marca"; fi
if [ -n "$ambiente" ]; then env | sed 's/=.*//' | sort > "$out/ambiente.txt"; fi
if [ -n "$conteiner" ]; then docker run -d --label "$BANCADA_DOCKER_LABEL" alpine:latest sleep 600 > "$out/conteiner.txt"; fi
echo "rodando:$ids"
sleep "$dorme"

# Cada prova de aparelho imprime nada quando passou, a mensagem quando falhou.
linha_de() { printf '%s\n' "$aparelhos" | sed -n "${1}p"; }
# O adb do aparelho: o servidor que o devices.json diz (no host-6, o do contêiner do emulador).
adb_de() {
  servidor=$(printf '%s' "$1" | sed -n 's/.*"adb":{"host":"\([^"]*\)","porta":\([0-9]*\)}.*/\1 \2/p')
  if [ -n "$servidor" ] && [ "${servidor%% *}" != 127.0.0.1 ]; then
    a() { "$adb" -H "${servidor%% *}" -P "${servidor##* }" "$@"; }
  else
    a() { "$adb" "$@"; }
  fi
}
escuta() {  # a máquina serve um sinal na porta e o aparelho o lê de lá
  porta=$1 serial=$2
  # Sem host (celular): nada a alcançar.
  [ -n "$3" ] || return 0
  echo "pronto-$porta" > "$out/rede-$porta.txt"
  nc -l "$porta" < "$out/rede-$porta.txt" > /dev/null 2>&1 &
  ouvinte=$!
  sleep 1
  a -s "$serial" shell "toybox nc -w 3 $3 $porta < /dev/null" > "$out/rede-$porta.log" 2>&1 || true
  kill "$ouvinte" 2>/dev/null || true
  wait "$ouvinte" 2>/dev/null || true
  grep -q "pronto-$porta" "$out/rede-$porta.log"
}
prova() {
  id=$1 n=${1##*-}
  if [ "$id" = portas-distintas ]; then
    faixas=$(printf '%s\n' "$aparelhos" | while IFS= read -r l; do numero "$l" inicio; echo; done | grep . | sort)
    [ "$(printf '%s\n' "$faixas" | uniq | wc -l)" -eq "$(printf '%s\n' "$faixas" | wc -l)" ] || echo "Esperava faixas de porta diferentes; achou repetidas"
    return 0
  fi
  l=$(linha_de "$n")
  serial=$(campo "$l" serial) udid=$(campo "$l" udid) inicio=$(numero "$l" inicio) host=$(campo "$l" host)
  adb_de "$l"
  case "$id" in
    ligado-*)
      if [ -n "$udid" ]; then
        xcrun simctl list devices | grep "$udid" | grep -q Booted || echo "Esperava o simulador ligado; achou desligado"
      else
        [ "$(a -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] || echo "Esperava sys.boot_completed 1; achou outro"
      fi ;;
    limpo-*)
      if [ -n "$udid" ]; then
        [ "$(xcrun simctl listapps "$udid" 2>/dev/null | grep -c 'ApplicationType = User')" -eq 0 ] || echo "Esperava nenhum app instalado; achou apps de usuário"
      else
        pacotes=$(a -s "$serial" shell pm list packages -3 2>/dev/null) || { echo "Esperava a lista de pacotes; o aparelho não respondeu"; return 0; }
        [ -z "$(printf '%s' "$pacotes" | tr -d '\r')" ] || echo "Esperava nenhum pacote de terceiros; achou algum"
      fi ;;
    wifi-*) [ "$(a -s "$serial" shell settings get global wifi_on 2>/dev/null | tr -d '\r')" = 0 ] || echo "Esperava Wi-Fi desligado; achou ligado" ;;
    rede-*) escuta "$inicio" "$serial" "$host" || echo "Esperava alcançar a porta $inicio em $host; não alcançou" ;;
    captura-*) xcrun simctl io "$udid" screenshot "$out/tela-$n.png" >/dev/null 2>&1 || echo "Esperava uma captura de tela; falhou" ;;
    porta-*) if nc -z 127.0.0.1 "$inicio" 2>/dev/null; then echo "Esperava a porta $inicio livre; achou ocupada"; fi ;;
  esac
  return 0
}
captura() {  # a tela do aparelho do cenário, como evidência
  l=$(linha_de "${1##*-}")
  if [ -n "$(campo "$l" udid)" ]; then
    xcrun simctl io "$(campo "$l" udid)" screenshot "$out/$1.png" >/dev/null 2>&1
  else
    adb_de "$l"
    a -s "$(campo "$l" serial)" exec-out screencap -p > "$out/$1.png" 2>/dev/null
  fi
}
falhou=""
if [ -z "$sem_summary" ]; then
  {
    printf '{ "versao": 1, "cenarios": ['
    sep=""
    for id in $ids; do
      case "$perdas" in *" $id "*) continue ;; esac
      motivo=""
      case "$ids_aparelhos " in *" $id "*) motivo=$(prova "$id") ;; esac
      if [ -n "$motivo" ] || { [ -n "$ids_aparelhos" ] && case "$falhas" in *" $id "*) case "$ids_aparelhos " in *" $id "*) true ;; *) false ;; esac ;; *) false ;; esac; }; then
        motivo=${motivo:-"Esperava falhar de propósito; falhou"}
        evidencia=""
        if [ "$id" != portas-distintas ] && captura "$id"; then evidencia="\"$id.png\""; fi
        printf '%s{ "id": "%s", "resultado": "falhou", "duracao_ms": 12, "mensagem": "%s", "evidencias": [%s] }' "$sep" "$id" "$motivo" "$evidencia"
        falhou=1
        sep=", "
        continue
      fi
      case "$falhas" in
        *" $id "*)
          echo "captura de $id" > "$out/$id.txt"
          printf '%s{ "id": "%s", "resultado": "falhou", "duracao_ms": 12, "mensagem": "Esperava \\"ok\\"; achou \\"erro\\"", "evidencias": ["%s.txt"] }' "$sep" "$id" "$id"
          falhou=1
          ;;
        *) printf '%s{ "id": "%s", "resultado": "passou", "duracao_ms": 10 }' "$sep" "$id" ;;
      esac
      sep=", "
    done
    printf '] }\n'
  } > "$out/summary.json.tmp"
  mv "$out/summary.json.tmp" "$out/summary.json"
fi
if [ -n "$sai" ]; then exit "$sai"; fi
if [ -n "$falhou" ]; then exit 1; fi
exit 0
