#!/usr/bin/env bash
# `plan` do projeto de exemplo: grava o planned.json antes de qualquer aparelho, só com os cenários (quantos aparelhos é
# a Bancada que decide). --cenarios N; --plan-vazio (seleção vazia: sai 2); --plan-sai <código>; --plan-grupos N (os
# cenários em N grupos, cada grupo num aparelho só, como as features que não se dividem). Bash 3.2.
set -eu
cenarios=2
vazio=""
sai=""
grupos=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cenarios) cenarios=$2; shift 2 ;;
    --plan-vazio) vazio=1; shift ;;
    --plan-sai) sai=$2; shift 2 ;;
    --plan-grupos) grupos=$2; shift 2 ;;
    *) shift ;;
  esac
done
out=${BANCADA_OUT:?BANCADA_OUT não definido}
if [ -n "$vazio" ]; then
  echo "nenhum cenário selecionado" >&2
  exit 2
fi
if [ -n "$sai" ]; then exit "$sai"; fi
mkdir -p "$out"
{
  printf '{ "versao": 1, "cenarios": ['
  sep=""
  i=1
  while [ "$i" -le "$cenarios" ]; do
    grupo=""
    if [ -n "$grupos" ]; then grupo=$(printf ', "grupo": "g%s"' $(((i - 1) % grupos + 1))); fi
    printf '%s{ "id": "c%s", "nome": "Exemplo › cenário c%s"%s }' "$sep" "$i" "$i" "$grupo"
    sep=", "
    i=$((i + 1))
  done
  printf '] }\n'
} > "$out/planned.json"
