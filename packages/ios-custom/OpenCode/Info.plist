<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDevelopmentRegion</key><string>pt-BR</string>
    <key>CFBundleDisplayName</key><string>OpenCode</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>OpenCodeCommit</key><string>$(OPENCODE_COMMIT)</string>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
    <key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string></dict>
    <key>NSLocalNetworkUsageDescription</key><string>O OpenCode acessa o servidor do seu Mac pela rede privada.</string>
    <key>NSCameraUsageDescription</key><string>O OpenCode usa a câmera para ler o QR code de pareamento do seu servidor.</string>
    <key>NSMicrophoneUsageDescription</key><string>O OpenCode usa o microfone para ditar mensagens com transcrição neste iPhone e para conversar por voz com a Sessão mestra, inclusive durante a chamada em segundo plano.</string>
    <key>NSHealthShareUsageDescription</key><string>Os agentes do OpenCode leem seus dados do app Saúde (sono, passos, energia, frequência cardíaca, VFC, treinos e peso) quando você pede. O OpenCode nunca grava no Saúde.</string>
    <key>NSHealthUpdateUsageDescription</key><string>O OpenCode não grava dados no app Saúde; os agentes só leem os dados que você permitir.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>Os agentes do OpenCode consultam sua localização atual quando você pede, com o app aberto.</string>
    <key>NSMotionUsageDescription</key><string>Os agentes do OpenCode leem passos, distância, andares e atividade dos últimos dias quando você pede.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>Os agentes do OpenCode veem a data, o local e uma miniatura das suas fotos recentes quando você pede.</string>
    <key>UIBackgroundModes</key><array><string>audio</string></array>
    <key>NSSupportsLiveActivities</key><true/>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
    <key>NSAppTransportSecurity</key><dict><key>NSExceptionDomains</key><dict>
        <key>opencode2-mac.alexandrem.com.br</key><dict>
            <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
        </dict>
        <key>seaweedfs-svc</key><dict>
            <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
        </dict>
        <key>llm-proxy-svc</key><dict>
            <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
        </dict>
    </dict></dict>
</dict></plist>
