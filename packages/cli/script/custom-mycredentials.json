{
  "policies": [
    {
      "name": "opencode-servidor",
      "description": "Servidor OpenCode custom no Mac (local.opencode.custom-manual), via manual.json mycred",
      "rules": [{ "pattern": "opencode/google-workspace/oauth-client-secret", "capabilities": ["read"] }],
      "bindings": [
        {
          "variable": "GOOGLE_WORKSPACE_MCP_CLIENT_SECRET",
          "path": "opencode/google-workspace/oauth-client-secret",
          "format": "raw"
        }
      ]
    }
  ]
}
