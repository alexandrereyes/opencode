{
  "policies": [
    {
      "name": "opencode-servidor",
      "description": "Servidor OpenCode custom no Mac (local.opencode.custom-manual), via manual.json mycred",
      "rules": [
        { "pattern": "opencode/google-workspace/oauth-client-secret", "capabilities": ["read"] },
        { "pattern": "opencode/watch/cf-access-service-token.json", "capabilities": ["read"] },
        { "pattern": "opencode/apns/AuthKey_H9J5YTMHT9.p8", "capabilities": ["read"] }
      ],
      "bindings": [
        {
          "variable": "GOOGLE_WORKSPACE_MCP_CLIENT_SECRET",
          "path": "opencode/google-workspace/oauth-client-secret",
          "format": "raw"
        },
        {
          "variable": "OPENCODE_WATCH_ACCESS_JSON",
          "path": "opencode/watch/cf-access-service-token.json",
          "format": "raw"
        },
        {
          "variable": "OPENCODE_APNS_KEY_P8",
          "path": "opencode/apns/AuthKey_H9J5YTMHT9.p8",
          "format": "raw"
        }
      ]
    }
  ]
}
